{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small", 
        // "type": "kitty or chaffa",
        // "source": "path/to/img.png",
        // "type": "file",
        // "source": "~/.config/fastfetch/coffee.txt",
        // "padding": { "top": 1 } 
    },
    "modules": [
        // {
        //     "type": "separator",
        //     "string": " "
        // },
        "title",
        {
            "type": "wm",
            "key": "WM",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "format": "{pretty-name}"
        },
        {
            "type": "editor",
            "format": "{name}"
        },
        {
            "type": "shell",
            "format": "{pretty-name}"
        },
        {
            "type": "TerminalFont",
            "key": "Font",
            "format": "{name~,-8}"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "block": {
                "range": [1, 6],
                "width": 3
            }
        }
        // {
        //     "type": "separator",
        //     "string": " "
        // }
    ]
}
