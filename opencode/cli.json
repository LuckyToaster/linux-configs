{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "attention": {
    "notifications": false,
    "sound": false,
    "volume": 1
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": false
  },
  "animations": true,
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "indicators": "status"
  }
}
