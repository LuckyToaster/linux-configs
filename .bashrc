#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

source ~/.bash_secrets.sh

PS1="\W\[\e[38;5;4m\]  \[\e[0m\]"

# FZF CONFIG
eval "$(fzf --bash)"
export FZF_DEFAULT_OPTS="--color=fg:-1,bg:-1,hl:4,fg+:15,bg+:8,hl+:14,info:3,prompt:1,pointer:2,marker:2,spinner:5,header:6"
export FZF_COMPLETION_OPTS="--layout reverse --height 100% --preview 'bat --color=always --style=numbers --line-range :500 {}'"
FZF_IGNORE_DIRS="--exclude .git --exclude node_modules --exclude __pycache__ --exclude .pytest_cache --exclude .cache --exclude .venv --exclude .local/share/Trash --exclude .cache"

_fzf_compgen_path() {
    fd --type f --hidden $FZF_IGNORE_DIRS
}

_fzf_compgen_dir() {
    fd --type d --hidden $FZF_IGNORE_DIRS
}

# YAZI - cd into directory when exiting yazi
function y() {
	local tmp cwd; tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
	command rm -f -- "$tmp"
}

export BAT_THEME='base16'
export EDITOR='nvim'
export OLLAMA_HOST=0.0.0.0 # make ollama listen to all network interfaces so that openweb-ui can access it

# UNI GARBAGE 💩 🚮
export JAVA_HOME='/usr/lib/jvm/default'
export HADOOP_HOME='/home/lucky/Downloads/hadoop-3.3.6'
export PATH=$PATH:$HADOOP_HOME/bin:$HADOOP_HOME/sbin
export HADOOP_CONF_DIR=$HADOOP_HOME/etc/hadoop

# ALIASES
alias ls='ls --color=auto'
alias grep='grep --color=auto'
# alias y='yazi'
alias n='nvim'
alias panotes='pandoc --template eisvogel --listings --pdf-engine=lualatex'
alias panpresi='pandoc -t beamer --slide-level=2 -s --toc -V tocdepth=2 -V theme:metropolis -V sectionpage=true -V urlcolor:blue'

# GENERATED BY CARGO
. "$HOME/.cargo/env"

# opencode
export PATH=/home/lucky/.opencode/bin:$PATH
alias oc='OPENCODE_ENABLE_EXA=1 OPENCODE_EXPERIMENTAL=true opencode'

. "$HOME/.local/bin/env"
